GOOGLE_APPLICATION_CREDENTIALS=./secrets/vertex-service-account.json
GOOGLE_CLOUD_PROJECT=your_gcp_project_id
GOOGLE_CLOUD_LOCATION=us-central1

# --- Accounts / user data storage ---
# Generate with: openssl rand -hex 32
SESSION_SECRET=
# nas = Synology NAS via FileStation API; local = files on this machine
STORAGE_BACKEND=local
DATA_DIR=./data
# Only needed when STORAGE_BACKEND=nas
NAS_URL=https://192.168.1.2:5001
NAS_USER=
NAS_PASSWORD=
NAS_DIR=/home/karmo_data

# Set to true only when the app is served over HTTPS
COOKIE_SECURE=false
